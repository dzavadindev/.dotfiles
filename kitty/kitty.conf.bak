font_family      family='FiraCode Nerd Font' style=Retina
bold_font        auto
italic_font      family='FiraCode Nerd Font' style=Light
bold_italic_font auto

font_size 16.0
background_opacity 0.9
background_blur 1

window_padding_width 8

# BEGIN_KITTY_THEME
# Tokyo Night
include current-theme.conf
# END_KITTY_THEME
