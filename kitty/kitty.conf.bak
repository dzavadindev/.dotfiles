font_family      family='FiraCode Nerd Font' style=Regular
bold_font        family='FiraCode Nerd Font' style=Bold
italic_font      family='FiraCode Nerd Font' style=Light
bold_italic_font family='FiraCode Nerd Font' style=SemiBold

font_size 13.0
background_opacity 0.75
background_blur 1

window_padding_width 8

# BEGIN_KITTY_THEME
# Gruvbox Dark Hard
include current-theme.conf
# END_KITTY_THEME
