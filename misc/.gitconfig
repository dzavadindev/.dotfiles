[user]
	email = daniil.zavadin@gmail.com
	name = dzavadindev

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[core]
	editor = nvim
[merge]
    tool = meld
    conflictstyle = zdiff3

[mergetool]
    prompt = false
	keepBackup = false

[mergetool "meld"]
    cmd = meld --output "$MERGED" "$LOCAL" "$BASE" "$REMOTE"
    trustExitCode = false
[diff]
	tool = critique
[difftool "critique"]
	cmd = critique difftool \"$LOCAL\" \"$REMOTE\"
