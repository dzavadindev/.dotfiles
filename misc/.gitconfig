[user]
	email = daniil.zavadin@gmail.com
	name = dzavadindev

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    autoSetupRemote = true

[core]
	editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true
    side-by-side = true 

[merge]
    tool = meld
    conflictstyle = zdiff3

[mergetool]
    prompt = false
	keepBackup = false

[mergetool "meld"]
    cmd = meld --output "$MERGED" "$LOCAL" "$BASE" "$REMOTE"
    trustExitCode = false
