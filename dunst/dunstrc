
[global]
# Positioning
origin = top-right
offset = (20,20)
width = (0,350)
height = (0,150)

# Appearance
font = "FiraCode Nerd Font" 16
transparency = 60
background = "#bcbcf2"
foreground = "#0f0f0f"

# Frame
frame_width = 2
frame_color = "#4C566A"

# Padding
padding = 10
horizontal_padding = 10
separator_color = frame

# Misc
indicate_hidden = yes
shrink = yes
markup = full
icon_position = left
corner_radius = 8

# Timeouts (optional tweaks)
timeout = 5
idle_threshold = 120

# Icon theme (optional)
icon_path = /usr/share/icons/Papirus-Dark/16x16/status

# Sort by urgency
sort = yes

