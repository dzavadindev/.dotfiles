# super key
set $mod Mod4

# terminal emulator
set $term kitty

# browser
set $BROWSER /home/dan/zen-browser/zen

# start the notification manager
exec dunst

# workspaces
set $ws1 '1'
set $ws2 '2'
set $ws3 '3'
set $ws4 '4'
set $ws5 '5'

# application launcher
set $menu fuzzel

# output configuration
output eDP-1 resolution 1920x1080@60.008Hz position 0,0

# wallpaper
output * bg /home/dan/.dotfiles/wpp/wpp2.jpg fill

# setting up the environment for xdg-desktop-portal-wlr (screenshare)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# apply gtk theme 
exec gsettings set org.gnome.desktop.interface gtk-theme Yaru-Lavender-dark

# allow xwayland
xwayland enable
for_window [shell="xwayland"] title_format "[XWayland] %title"

# floating nmtui for network in waybar
for_window [app_id = "nmwui"] floating enable

# drag, resize widows with super+mouse
floating_modifier $mod normal

### gaps
gaps inner 3px
gaps outer 3px

### border
default_border pixel 1.5px
default_floating_border pixel 1.5px

### border color
###                     border  bg      text    ind     c_border
client.focused          #83a598 #0F0F0F #ebdcb2 #83a598 #83a598
client.focused_inactive #ebdcb2 #0F0F0F #d8cab8 #d8cab8 #d8cab8
client.unfocused        #ebdcb2 #0F0F0F #d8cab8 #ebdcb2 #ebdcb2
client.urgent           #fcb167 #0F0F0F #d8cab8 #fcb167 #fcb167
client.placeholder      #ebdcb2 #0F0F0F #d8cab8 #ebdcb2 #ebdcb2

### idle configuration
exec swayidle -w \
	timeout 30 'swaylock -f' \
	timeout 60 'swaymsg "output * power off"' \
	resume 'swaymsg "output * power on"'

### input configuration
# Read `man 5 sway-input` for more information about this section.

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll disabled
}

input type:keyboard {
  xkb_layout us,ua
  xkb_options ctrl:nocaps,grp:alt_shift_toggle
}

###-------------------------------------
###            Key bindings
###-------------------------------------


mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym Alt_L+Shift gpr:switch

bindsym --to-code {

# start a terminal
$mod+t exec $term

# start wofi
$mod+w exec $menu

# start web-browser
$mod+b exec "env -u WAYLAND_DISPLAY /home/dan/zen-browser/zen"

# discord 
$mod+d exec discord

# steam
$mod+s exec steam

# start filemanager (Nemo)
$mod+n exec dolphin

# kill focused window
$mod+q kill

# reload the configuration file
$mod+Shift+c reload

# exit sway (logs you out of your Wayland session)
$mod+Shift+e exec /home/dan/.dotfiles/scripts/powermenu.sh

# move focus with vim navigation
$mod+h focus left
$mod+j focus down
$mod+k focus up
$mod+l focus right

# move the focused window with vim navigation
$mod+Shift+h move left
$mod+Shift+j move down
$mod+Shift+k move up
$mod+Shift+l move right

# workspaces:
# switch to workspace
$mod+1 workspace $ws1
$mod+2 workspace $ws2
$mod+3 workspace $ws3
$mod+4 workspace $ws4
$mod+5 workspace $ws5

# move focused container to workspace
$mod+Shift+1 move container to workspace $ws1
$mod+Shift+2 move container to workspace $ws2
$mod+Shift+3 move container to workspace $ws3
$mod+Shift+4 move container to workspace $ws4
$mod+Shift+5 move container to workspace $ws5

# make the current focus fullscreen
$mod+f fullscreen

# move the the next workspace
$mod+Tab workspace back_and_forth

# toggle the current focus between tiling and floating mode
$mod+Shift+space floating toggle

# swap focus between the tiling area and the floating area
$mod+space focus mode_toggle

# move the currently focused window to the scratchpad
$mod+Shift+minus move scratchpad

# show the next scratchpad window or hide the focused scratchpad window.
# if there are multiple scratchpad windows, this command cycles through them.
$mod+minus scratchpad show

# resizing containers:
$mod+r mode "resize"

# special keys to adjust volume via PulseAudio
--locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
--locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
--locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
--locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# special keys to adjust brightness via brightnessctl
--locked XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
--locked XF86MonBrightnessUp exec --no-startup-id brightnessctl set 10%+

# special key to take a screenshot with grim
Print exec grim
}

# status bar:
bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*
