{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.3-codex",
    "permission": {
        "external_directory": {
            "~/.99-prompts/**": "allow"
        }
    },
    "provider": {
        "openai": {
            "options": {
                "apiKey": "{file:~/.secrets/openai-key}"
            }
        }
    },
    "enabled_providers": [
        "openai",
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        }
    }
}
