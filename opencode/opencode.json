{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "external_directory": {
            "/tmp/99-state/**": "allow"
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{file:~/.secrets/context7-key}"
            }
        }
    }
}
