{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.3-codex",
    "permission": {
        "external_directory": {
            "~/.99-prompts/**": "allow"
        }
    },
    "provider": {
        "openai": {
            "options": {
                "apiKey": "{file:~/.secrets/openai-key}"
            }
        }
    },
    "enabled_providers": [
        "openai",
    ],
}
